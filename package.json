{
  "name": "custom-user-js-scripts",
  "version": "0.1.9",
  "private": true,
  "description": "A personal workspace for writing and modifying browser userscripts.",
  "author": "dzshzx <dzshzx0930+github@gmail.com>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dzshzx/custom-user-js-scripts.git"
  },
  "scripts": {
    "build": "node scripts/build-userscripts.mjs",
    "prelint": "npm run build",
    "lint": "node scripts/check-userscripts.mjs && tsc -p . && eslint .",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "test:prepare": "node scripts/prepare-tests.mjs",
    "typecheck": "tsc -p .",
    "verify": "node scripts/verify.mjs"
  },
  "keywords": [
    "userscript",
    "tampermonkey",
    "violentmonkey",
    "browser-script"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/spark-md5": "3.0.5",
    "@types/tampermonkey": "5.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "playwright": "1.63.0",
    "preact-render-to-string": "6.7.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@date-fns/utc": "2.1.1",
    "@floating-ui/dom": "1.8.0",
    "commander": "15.0.0",
    "date-fns": "4.4.0",
    "fast-json-stable-stringify": "2.1.0",
    "filenamify": "7.0.3",
    "idb-keyval": "6.3.0",
    "lucide-preact": "1.52.0",
    "mime": "4.1.0",
    "p-limit": "7.3.3",
    "preact": "11.0.0",
    "quick-lru": "7.3.0",
    "semver": "7.8.5",
    "spark-md5": "3.0.2",
    "valibot": "1.5.0"
  }
}
